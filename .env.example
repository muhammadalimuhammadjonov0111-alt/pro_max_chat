DATABASE_URL="file:./dev.db"
BETTER_AUTH_SECRET="generate_a_long_random_secret_here"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- To'lov (shaxsiy kartaga tayyor havola) ---------------------------------
# Rasman merchant EMAS: foydalanuvchi Click/Payme orqali shaxsiy kartaga
# pul o'tkazadi, admin tasdiqlagach Premium yoqiladi.
# Karta raqami faqat .env da saqlanadi, hech qachon kodga yozilmaydi!
# PAYMENT_CARD_NUMBER="8600123456789012"
# PAYMENT_CARD_HOLDER="Ismingiz familiyangiz"
# CLICK_PAY_URI="https://click.uz"
# PAYME_PAY_URI="https://payme.uz"

# --- Telegram bot (to'lov + chek bildirishnomalari) ------------------------
# 1) BotFather dan @botfather -> /newbot orqali oling (yangi token oling, eskisini revoke qiling!)
# 2) Botga /start berasiz, chat_id ni olish uchun https://api.telegram.org/bot<TOKEN>/getUpdates
#    MUHIM: chat_id = SIZNING Telegram ID'ingiz (botning ID'si EMAS).
# 3) Admin panel → «Telegramni tekshirish» tugmasi bilan test xabar yuboring.
# 4) Sayt https:// da bo'lsa webhook avtomatik ulanadi (GET /api/telegram/webhook).
# TELEGRAM_BOT_TOKEN="..."
# TELEGRAM_ADMIN_CHAT_ID="..."  # SIZNIKISI: @userinfobot dan oling
# TELEGRAM_WEBHOOK_SECRET="..."  # webhook maxfiyligi (ixtiyoriy)

# --- Parol tiklash email (SMTP) ----------------------------------------------
# SMTP sozlanmasa, tiklash havolasi terminalda (npm run dev oynasi) chiqadi.
# Prod'da real email uchun Gmail yoki boshqa SMTP yozing.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="...@gmail.com"
# SMTP_PASS="..."  # Gmail App password (16 ta belgi)
# SMTP_FROM="Gidgogram <...@gmail.com>"
# SMTP_SECURE="false"

# --- AI bots (optional) -------------------------------------------------
# Add ONE of the keys below to enable real AI replies from bots.
# Without a key, bots still answer using a built-in local fallback.
# OPENROUTER_API_KEY="sk-or-..."
# OPENAI_API_KEY="sk-..."
# BOT_MODEL="openai/gpt-4o-mini"

